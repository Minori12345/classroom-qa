<!doctype html>
<html lang="ja">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>授業Q&amp;A</title></head>
<body>
  <main>
    <h1>授業Q&amp;A</h1>
    <a href="/questions/new">質問を投稿する</a>
    <h2>質問一覧</h2>
    <form action="/" method="get">
      <%# カテゴリ選択 %>
      <label>
        カテゴリ
        <select name="category">
          <option value="">すべて</option>
          <% for (const option of categories) { %>
            <option value="<%= option %>" <%= category === option ? 'selected' : '' %>><%= option %></option>
          <% } %>
        </select>
      </label>
      <%# 検索欄 %>
      <label>
        キーワード
        <input type="search" name="q" value="<%= keyword %>">
      </label>
      <button type="submit">検索</button>
    </form>
    <% if (!questions.length) { %>
      <p><%= keyword || category ? '該当する質問がありません。' : 'まだ質問がありません。' %></p>
    <% } else { %>
      <ul>
        <% for (const question of questions) { %>
          <li><a href="/questions/<%= question.id %>"><%= question.title %></a>（<%= question.category %>・<%= question.author %>）</li>
        <% } %>
      </ul>
    <% } %>
  </main>
</body>
</html>
